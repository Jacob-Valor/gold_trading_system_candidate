# Copy this file to .env, then replace every REPLACE_* value before starting.
# Generate each secret independently (for example: `openssl rand -hex 32`);
# do not reuse secrets between JWT, database, admin, or user credentials.

# PostgreSQL container credentials. Hex passwords avoid URL-encoding issues.
POSTGRES_USER="gold"
POSTGRES_PASSWORD="REPLACE_WITH_64_RANDOM_HEX_CHARACTERS"
POSTGRES_DB="gold_trading"

# Local Prisma CLI/app connection. Keep the password in sync with POSTGRES_PASSWORD.
DATABASE_URL="postgresql://gold:REPLACE_WITH_THE_SAME_POSTGRES_PASSWORD@localhost:5432/gold_trading"

# JWT signing secret: use at least 32 random bytes (64 hexadecimal characters).
JWT_SECRET="REPLACE_WITH_64_RANDOM_HEX_CHARACTERS"
JWT_EXPIRES_IN="24h"

# Base mock gold price in USD per gram.
GOLD_PRICE_USD="125.42"

# Demo-only funding endpoint. Keep false in production; set true only for this candidate demo.
ALLOW_SIMULATED_DEPOSITS=false

# Idempotent seed accounts. Use unique emails and independently generated passwords.
SEED_ADMIN_EMAIL="REPLACE_WITH_ADMIN_EMAIL"
SEED_ADMIN_PASSWORD="REPLACE_WITH_HIGH_ENTROPY_ADMIN_PASSWORD"
SEED_USER_EMAIL="REPLACE_WITH_USER_EMAIL"
SEED_USER_PASSWORD="REPLACE_WITH_HIGH_ENTROPY_USER_PASSWORD"

# App host port. Compose binds it to 127.0.0.1 only.
PORT=3000

# TLS edge (`docker compose --profile production up -d`).
# Use a real DNS name for automatic public certificates; localhost uses Caddy's local CA.
DOMAIN="localhost"
HTTP_PORT=80
HTTPS_PORT=443

# Keep false for direct local access. Set true only when all traffic arrives through the Caddy edge.
TRUST_PROXY=false

# Local Redis URL. Compose supplies its own internal service URL.
REDIS_URL="redis://localhost:6379"