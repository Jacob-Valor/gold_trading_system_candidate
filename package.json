{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "gold-trading-system",
  "version": "1.0.0",
  "private": true,
  "description": "Secure RESTful backend for a Gold Trading System — Next.js (App Router), TypeScript, Prisma, PostgreSQL",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test": "vitest run",
    "test:unit": "vitest run tests/config.test.ts tests/schemas.test.ts tests/pagination.test.ts tests/validate.test.ts",
    "test:integration": "vitest run tests/api.integration.test.ts",
    "test:cleanup": "tsx scripts/cleanup-test-data.ts --all",
    "test:coverage": "vitest run --coverage tests/config.test.ts tests/schemas.test.ts tests/pagination.test.ts tests/validate.test.ts",
    "smoke": "bash scripts/smoke.sh",
    "db:backup": "bash scripts/db-backup.sh",
    "db:restore": "bash scripts/db-restore.sh",
    "db:verify-backup": "bash scripts/db-verify-backup.sh"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "next": "^16.3.2",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "prisma": "^7.9.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
